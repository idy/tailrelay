#!/bin/sh
set -eu
case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl list-units --type=service --state=active --no-legend --plain 'tailrelay@*.service' |
                while read -r unit rest; do
                    case "$unit" in
                        tailrelay@*.service) deb-systemd-invoke stop "$unit" || true ;;
                    esac
                done
        fi
        ;;
esac
